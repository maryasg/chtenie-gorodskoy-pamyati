# --- ТЕКСТЫ (KupiAPI) ---
OPENAI_API_KEY=rk_live_ваш-ключ-kupiapi
OPENAI_BASE_URL=https://kupiapi.ru/v1
TEXT_MODEL=gpt-4o-mini

# --- КАРТИНКИ (отдельный сервис — KupiAPI картинки не делает) ---
# Пример: ProxyAPI — https://proxyapi.ru
IMAGE_API_KEY=ваш-ключ-для-картинок
IMAGE_BASE_URL=https://api.proxyapi.ru/openai/v1
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1792x1024

# Если картинки и тексты с одного OpenAI-аккаунта — IMAGE_* можно не задавать
