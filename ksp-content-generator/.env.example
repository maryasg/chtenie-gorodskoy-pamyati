# API key (KupiAPI, OpenAI или другой OpenAI-compatible провайдер)
OPENAI_API_KEY=your-api-key-here

# Base URL — для KupiAPI:
OPENAI_BASE_URL=https://kupiapi.ru/v1
# Для OpenAI напрямую раскомментируйте:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Тексты: gpt-4o-mini (баланс), deepseek-chat (дешевле), gpt-4o / claude-sonnet (качество)
# См. SERVICES.md — полный каталог и рекомендации
TEXT_MODEL=gpt-4o-mini

# Картинки: уточните доступные image-модели в KupiAPI
IMAGE_MODEL=dall-e-3

# dall-e-3: формат 16:9
IMAGE_SIZE=1792x1024
